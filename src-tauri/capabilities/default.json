{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allows the local Tauri control panel to use application commands.",
  "windows": ["control-panel"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "allow-start-twitch-device-authorization",
    "allow-poll-twitch-device-authorization",
    "allow-restore-twitch-authorization",
    "allow-logout-twitch",
    "allow-send-twitch-shoutout",
    "allow-get-overlay-settings",
    "allow-save-overlay-settings",
    "allow-get-custom-stamps",
    "allow-reload-custom-stamps",
    "allow-get-custom-stamp-editor-data",
    "allow-open-custom-stamp-directory",
    "allow-save-custom-stamp-definitions",
    "allow-get-custom-fonts",
    "allow-reload-custom-fonts",
    "allow-open-custom-font-directory",
    "allow-get-external-emotes",
    "allow-save-audience-interactions",
    "allow-open-audience-directory",
    "allow-clear-audience-interactions",
    "allow-get-runtime-info",
    "allow-get-overlay-window-visibility",
    "allow-set-overlay-window-visibility",
    "allow-notify-manual-raid-ready",
    "allow-notify-raid-phase",
    "allow-emit-overlay-test",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://www.twitch.tv/activate*" }]
    }
  ]
}
