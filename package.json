{
  "name": "text-flow-overlay-for-twitch-desktop",
  "version": "1.0.0",
  "description": "A desktop app that streams Twitch comments.",
  "license": "MIT",
  "author": "Tansan Vision",
  "type": "module",
  "main": "dist/bootstrap/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev:tauri": "node scripts/run-tauri.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "tauri": "tauri",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:portable": "node scripts/build-portable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "uuid": "^14.0.1"
  }
}
